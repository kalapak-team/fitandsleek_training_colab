# Neon PostgreSQL (do not commit real password)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Recommended on PC without GPU (32GB RAM):
MODEL_ID=Qwen/Qwen2.5-3B-Instruct
USE_LLM=1

# After fine-tune on Colab/GPU:
# LORA_ADAPTER=models/fitandsleek-lora

# Faster / weaker:
# MODEL_ID=sail/Sailor2-1B-Chat
# USE_LLM=0

# Needs GPU:
# MODEL_ID=sail/Sailor2-8B-Chat
